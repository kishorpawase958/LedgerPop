<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="center"
    android:background="@drawable/widget_bg_dark">

    <ImageView
        android:id="@+id/iv_add_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add_widget"
        android:tint="@color/widget_accent_dark"
        android:contentDescription="Add Transaction"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Txn"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary_dark"/>
</LinearLayout>
