<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spends Today"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary_light"/>

            <TextView
                android:id="@+id/tv_spends_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary_light"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#15000000"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Month"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary_light"/>

            <TextView
                android:id="@+id/tv_spends_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_accent"/>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_add_txn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:padding="10dp"
        android:src="@drawable/ic_add_widget"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Add Transaction"
        android:layout_margin="8dp"/>
</RelativeLayout>
